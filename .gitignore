_output/
_freeze/
.quarto/
cache/
*.pyc
__pycache__/
.venv/
.ipynb_checkpoints/
*.log

/.quarto/

# secrets and credentials — never commit
.secrets/
*.key
*.pem
.env
.netrc

# third-party copyrighted material — do not redistribute
/*.pdf
resources/pdfs/
resources/text/

# large derived artefacts — host externally (ENA / Zenodo)
data/taxonomy/feature-table-trips1-5.tsv
data/taxonomy/ASV_seqs-trips1-5.fasta
data/functional/picrust2/KO_predicted.tsv
data/functional/picrust2/EC_predicted.tsv
data/functional/picrust2/ko_pred_metagenome_unstrat.tsv

# notebook rendered artefacts — regenerated by `make figures`
notebooks/*_files/
notebooks/*.html
notebooks/.jupyter_cache/

# MAG bulky outputs — summary TSVs kept, full outputs regeneratable
cache/csp_mags/antismash/*/
cache/csp_mags/*__SemiBin_*/
cache/csp_mags/*__SemiBin_*_gapseq/gapseq_find.log
cache/csp_mags/*__SemiBin_*_gapseq/gapseq_transport.log
