// Resource overrides for the control-library re-denoising (14 small libraries).
// The canonical runs used custom.config / ibex_dada2.config with larger requests
// (DADA2_DENOISING 16-128 cpus, 64-256 GB); resource sizes do not change results.
process {
  withName: '.*:DADA2_ERR' {
    cpus   = 8
    memory = '32 GB'
    time   = '6h'
  }
  withName: '.*:DADA2_DENOISING' {
    cpus   = 8
    memory = '32 GB'
    time   = '12h'
  }
  withName: '.*:DADA2_RMCHIMERA' {
    cpus   = 8
    memory = '32 GB'
    time   = '6h'
  }
  withName: '.*:DADA2_TAXONOMY' {
    cpus   = 16
    memory = '64 GB'
    time   = '12h'
  }
}
