_output/
_freeze/
.quarto/
cache/
*.pyc
__pycache__/
.venv/
.ipynb_checkpoints/
*.log

/.quarto/

# secrets and credentials — never commit
.secrets/
*.key
*.pem
.env
.netrc

# third-party copyrighted material — do not redistribute
/*.pdf
resources/pdfs/
resources/text/

# large derived artefacts — host externally (ENA / Zenodo)
data/taxonomy/feature-table-trips1-5.tsv
data/taxonomy/ASV_seqs-trips1-5.fasta
data/functional/picrust2/KO_predicted.tsv
data/functional/picrust2/EC_predicted.tsv
data/functional/picrust2/ko_pred_metagenome_unstrat.tsv

# notebook rendered artefacts — regenerated by `make figures`
notebooks/*_files/
notebooks/*.html
notebooks/.jupyter_cache/

# MAG bulky outputs — summary TSVs kept, full outputs regeneratable
cache/csp_mags/antismash/*/
cache/csp_mags/*__SemiBin_*/
cache/csp_mags/*__SemiBin_*_gapseq/gapseq_find.log
cache/csp_mags/*__SemiBin_*_gapseq/gapseq_transport.log

# Externally-sourced climate rasters — fetch on demand, do not commit
# WorldClim 2.1 historical 10-arcmin bio variables (~21 MB zip):
#   curl -L -o data/worldclim/wc2.1_10m_bio.zip \
#     https://geodata.ucdavis.edu/climate/worldclim/2_1/base/wc2.1_10m_bio.zip
#   (cd data/worldclim && unzip -o wc2.1_10m_bio.zip)
# WorldClim 2.1 CMIP6 future bioclim (UKESM1-0-LL, 2081–2100, ~7-13 MB each):
#   curl -L -o data/worldclim/wc2.1_10m_bioc_UKESM1-0-LL_ssp245_2081-2100.tif \
#     https://geodata.ucdavis.edu/cmip6/10m/UKESM1-0-LL/ssp245/wc2.1_10m_bioc_UKESM1-0-LL_ssp245_2081-2100.tif
#   curl -L -o data/worldclim/wc2.1_10m_bioc_UKESM1-0-LL_ssp370_2081-2100.tif \
#     https://geodata.ucdavis.edu/cmip6/10m/UKESM1-0-LL/ssp370/wc2.1_10m_bioc_UKESM1-0-LL_ssp370_2081-2100.tif
data/worldclim/
